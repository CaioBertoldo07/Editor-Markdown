{
  "name": "editor-markdown-latex-compiler",
  "version": "0.1.0",
  "private": true,
  "description": "Serviço isolado de compilação LaTeX (TeX Live + latexmk) do Editor Markdown.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.12"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
