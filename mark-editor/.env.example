# URLs do projeto Neon (publicas por design: o browser precisa delas).
# Quem protege os dados e o RLS no banco, nao o segredo dessas URLs.
# Encontre em: Neon Console > seu projeto > Auth (Configuration) e Data API.
VITE_NEON_AUTH_URL=https://<endpoint>.neonauth.<regiao>.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://<endpoint>.apirest.<regiao>.aws.neon.tech/neondb/rest/v1
