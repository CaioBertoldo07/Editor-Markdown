{
  "name": "editor-markdown-api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Editor Markdown: Better Auth self-hosted + documentos e pastas sobre PostgreSQL (Railway).",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/src/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "ops": "node dist/src/ops/run.js"
  },
  "dependencies": {
    "@better-auth/core": "1.6.33",
    "@hono/node-server": "2.1.3",
    "better-auth": "1.6.33",
    "hono": "4.13.12",
    "pg": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pg": "8.15.6",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "vitest": "4.1.12"
  }
}
