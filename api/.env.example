# API do Editor Markdown — variáveis de ambiente (exemplo, sem segredos reais)

NODE_ENV=development
PORT=3000
# 0.0.0.0 (IPv4) ou :: (IPv6/dual-stack)
HOST=0.0.0.0

# Conexão do papel app_api (NUNCA o administrador). No Railway: URL privada do Postgres.
DATABASE_URL=postgres://app_api:<senha-do-app_api>@localhost:5432/editor_markdown
DB_POOL_MAX=10

# Segredo do Better Auth: 32+ bytes aleatórios (ex.: openssl rand -base64 48).
BETTER_AUTH_SECRET=<gere-um-segredo-longo-e-aleatorio>

# Origem pública do app (o navegador só fala com este domínio; /api/* é repassado à API).
BETTER_AUTH_URL=http://localhost:5173
# Origens extras aceitas, separadas por vírgula (a de BETTER_AUTH_URL já entra).
TRUSTED_ORIGINS=

# De onde ler o IP do cliente para o rate limit (ajustar no ensaio em staging).
IP_ADDRESS_HEADERS=x-forwarded-for
# IPs/CIDRs dos proxies confiáveis, para cadeias de X-Forwarded-For.
TRUSTED_PROXIES=

# --- Só em STAGING (vazias em produção) ---
# Exige o cabeçalho x-staging-key em tudo, exceto GET /api/health (32+ caracteres).
STAGING_ACCESS_KEY=
# Liga GET /api/_diag/request (cabeçalhos de proxy, IPs mascarados).
ENABLE_REQUEST_DIAGNOSTICS=false

# --- Compilação LaTeX (serviço editor-markdown-latex, rede privada) ---
# Vazio = compilação desligada (503 compiler_not_configured); o resto do app funciona.
# COMPILER_URL=http://editor-markdown-latex.railway.internal:8080
# COMPILER_TOKEN=<o mesmo COMPILER_TOKEN do serviço de compilação, 32+ caracteres>
# COMPILER_TIMEOUT_MS=150000
# COMPILE_RATE_PER_MINUTE=20
# COMPILE_MAX_ACTIVE_PER_USER=2

# --- Só para migrations (não vai para o serviço da API) ---
# MIGRATION_DATABASE_URL=postgres://postgres:<senha-admin>@localhost:5432/editor_markdown
# APP_API_DB_PASSWORD=<senha-longa-do-app_api>

# --- Serviço de operações (OPS_TASK=migrate|staging-check|transfer-inspect|transfer-execute|idle) ---
# OPS_TASK=idle
# STAGING_PRIVATE_URL=http://editor-markdown-api.railway.internal:8080
# STAGING_PUBLIC_URL=https://<dominio-de-staging>
# STAGING_ORIGIN=https://<dominio-de-staging>
# NEON_DATABASE_URL=   (só durante a transferência autorizada; remover depois)
# TRANSFER_CONFIRM=    (COPIAR-NEON-PARA-STAGING só na execução autorizada)
