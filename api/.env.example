# API do Editor Markdown — variáveis de ambiente (exemplo, sem segredos reais)

NODE_ENV=development
PORT=3000
# 0.0.0.0 (IPv4) ou :: (IPv6/dual-stack)
HOST=0.0.0.0

# Conexão do papel app_api (NUNCA o administrador). No Railway: URL privada do Postgres.
DATABASE_URL=postgres://app_api:<senha-do-app_api>@localhost:5432/editor_markdown
DB_POOL_MAX=10

# Segredo do Better Auth: 32+ bytes aleatórios (ex.: openssl rand -base64 48).
BETTER_AUTH_SECRET=<gere-um-segredo-longo-e-aleatorio>

# Origem pública do app (o navegador só fala com este domínio; /api/* é repassado à API).
BETTER_AUTH_URL=http://localhost:5173
# Origens extras aceitas, separadas por vírgula (a de BETTER_AUTH_URL já entra).
TRUSTED_ORIGINS=

# De onde ler o IP do cliente para o rate limit (ajustar no ensaio em staging).
IP_ADDRESS_HEADERS=x-forwarded-for
# IPs/CIDRs dos proxies confiáveis, para cadeias de X-Forwarded-For.
TRUSTED_PROXIES=

# --- Só para migrations (não vai para o serviço da API) ---
# MIGRATION_DATABASE_URL=postgres://postgres:<senha-admin>@localhost:5432/editor_markdown
# APP_API_DB_PASSWORD=<senha-longa-do-app_api>
